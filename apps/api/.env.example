# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://fin:fin@localhost:5432/financiers_dev
APP_ORIGIN=http://localhost:3000
# Generate each with: openssl rand -base64 32   (they must differ)
DATA_ENCRYPTION_KEY=
BLIND_INDEX_KEY=
# Local development only; production refuses to start with ENFORCE_MFA=false.
ENFORCE_MFA=true
FILE_STORAGE_DIR=./storage
# Used by `pnpm db:seed` to create the first Super Admin (must be changed at first login).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# Public web address printed on receipts (QR verification link). Defaults to APP_ORIGIN.
# PUBLIC_WEB_URL=https://app.example.in

# Messaging — official APIs only. With 'log' nothing is sent and messages are marked SIMULATED.
SMS_PROVIDER=log
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=ABCDEF            # 6-letter DLT-registered header
# MSG91_WEBHOOK_TOKEN=              # random, 24+ chars; MSG91 calls /api/v1/webhooks/msg91?token=...
WHATSAPP_PROVIDER=log
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=            # permanent system-user token from Meta Business
# WHATSAPP_APP_SECRET=              # verifies webhook signatures
# WHATSAPP_VERIFY_TOKEN=            # random, 16+ chars; used once when registering the webhook

# Malware scanning of uploads (clamd host:port). Required in production; in development uploads
# are marked CLEAN without a scanner.
# CLAMAV_ADDRESS=clamav:3310

# Requests per client IP per minute for the default limiter (sign-in has its own, tighter limits).
# RATE_LIMIT_PER_MINUTE=300

# Refuse all changes (reads still work) — e.g. during a restore. Also switchable in System health.
# MAINTENANCE_MODE=false
