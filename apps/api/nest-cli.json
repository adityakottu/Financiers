{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "tsConfigPath": "tsconfig.build.json",
    "deleteOutDir": true,
    "assets": [{ "include": "db/migrations/*.sql", "outDir": "dist" }, { "include": "db/roles.sql", "outDir": "dist" }],
    "watchAssets": true
  }
}
