{
  "name": "@fin/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:roles": "tsx src/db/roles.ts",
    "db:verify": "tsx src/integrity/cli.ts",
    "perf:seed": "nest build && node dist/perf/seed-volume.js",
    "perf:load": "tsx src/perf/load-test.ts",
    "db:codegen": "kysely-codegen --dialect postgres --date-parser string --out-file src/db/schema.ts --exclude-pattern schema_migrations",
    "db:seed:demo": "nest build && node dist/db/seed-demo.js"
  },
  "dependencies": {
    "@fin/contracts": "workspace:*",
    "@fin/loan-engine": "workspace:*",
    "@fin/money": "workspace:*",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "kysely": "^0.29.6",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.6",
    "@swc/core": "^1.16.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.4",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "kysely-codegen": "^0.20.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.2.7"
  }
}
