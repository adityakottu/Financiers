# Copy to .env (never commit it; chmod 600). Generate keys with:  openssl rand -base64 32
DOMAIN=app.example.in
APP_ORIGIN=https://app.example.in
NODE_ENV=production
VERSION=latest

# The app connects as the least-privilege role fin_app (created by the release task).
DATABASE_URL=postgresql://fin_app:CHANGE_ME@your-rds-endpoint.ap-south-1.rds.amazonaws.com:5432/financiers?sslmode=require
# Schema owner: used only by the release task and backups.
MIGRATE_DATABASE_URL=postgresql://fin_owner:CHANGE_ME@your-rds-endpoint.ap-south-1.rds.amazonaws.com:5432/financiers?sslmode=require
FIN_APP_PASSWORD=CHANGE_ME
# Only with --profile localdb (then use host "postgres" in the two URLs above, without sslmode):
# POSTGRES_PASSWORD=CHANGE_ME

# Two different random 32-byte keys. Back them up separately (sealed envelope) — losing them loses encrypted data.
DATA_ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# First deploy only: the Super Admin's temporary password (must be changed at first sign-in). Remove afterwards.
SEED_ADMIN_PASSWORD=
SEED_COMPANY_NAME=Your Company Pvt Ltd

# Documents: local volume (backed up with the server) or S3 (preferred).
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3
# S3_BUCKET=fin-documents-…
# S3_REGION=ap-south-1
# S3_KMS_KEY_ID=arn:aws:kms:ap-south-1:…

# Nightly backups: an S3 bucket in India with Object Lock (preferred), or the local `backups` volume.
BACKUP_TARGET=/backups
# BACKUP_TARGET=s3://fin-backups-…/postgres

# Messaging (official APIs only; 'log' sends nothing).
SMS_PROVIDER=log
WHATSAPP_PROVIDER=log
