{
  "name": "financiers",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** run build && pnpm -r --filter ./apps/** run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "pnpm -r run test",
    "db:migrate": "pnpm --filter @fin/api run db:migrate",
    "db:seed": "pnpm --filter @fin/api run db:seed",
    "dev:api": "pnpm --filter @fin/api run dev",
    "dev:web": "pnpm --filter @fin/web run dev"
  }
}
